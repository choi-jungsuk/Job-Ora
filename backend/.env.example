# API keys
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Optional providers
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# MongoDB logging
MONGODB_URL=your-mongodb-atlas-connection-string
MONGODB_DB_NAME=jobora_db

# Frontend origins allowed to call this API
# Add Railway frontend URL first, then custom domain after DNS is connected.
CORS_ORIGINS=http://localhost:3000,https://job-ora.com,https://www.job-ora.com

# Toss Payments (토스페이먼츠 심사용 설정 - Railway Variables에 등록)
TOSS_SECRET_KEY=test_sk_your_secret_key_here
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_SUCCESS_URL=https://job-ora.com/payments/success
TOSS_FAIL_URL=https://job-ora.com/payments/fail
